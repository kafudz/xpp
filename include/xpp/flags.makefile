LIBS=x11 \
     xcb \
     xcb-icccm \
     xcb-sync \
     xcb-xf86dri \
     xcb-xprint \
     xcb-xinput \
     xcb-shape \
     xcb-shm \
     xcb-render \
     xcb-proto \
     xcb-event \
     xcb-xfixes \
     xcb-xkb \
     xcb-dri3 \
     xcb-ewmh \
     xcb-util \
     xcb-renderutil \
     xcb-xtest \
     xcb-xevie \
     xcb-keysyms \
     xcb-image \
     xcb-composite \
     xcb-randr \
     xcb-present \
     xcb-xv \
     xcb-aux \
     xcb-record \
     xcb-dpms \
     xcb-glx \
     xcb-atom \
     xcb-damage \
     xcb-screensaver \
     xcb-xvmc \
     xcb-res \
     xcb-xinerama \
     xcb-dri2

# Directory of this file, resolved before anything else can change
# MAKEFILE_LIST (include/xpp).
XPP_FLAGS_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))

# Hand written headers (xpp/xpp.hpp, ...)
XPP_INCLUDE ?= $(abspath ${XPP_FLAGS_DIR}/..)

# The protocol bindings (xpp/proto/*.hpp) are generated by CMake. Build the
# `xpp` target first (cmake -B build && cmake --build build) or point this
# variable at another build directory:
#   make XPP_GENERATED=/path/to/build/generated-sources/include
XPP_GENERATED ?= $(abspath ${XPP_FLAGS_DIR}/../../build/generated-sources/include)

# keep in sync with CMakeLists.txt (-std=c++14)
CXXFLAGS=-std=c++14 -Wall -O0 -I${XPP_INCLUDE} -I${XPP_GENERATED} $(shell pkg-config --cflags ${LIBS})
LDFLAGS=$(shell pkg-config --libs ${LIBS})
# libraries have to come after the objects/sources on the link line
LDLIBS=${LDFLAGS}
